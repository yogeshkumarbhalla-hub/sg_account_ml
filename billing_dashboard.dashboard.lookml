- dashboard: billing_dashboard
  title: Billing Dashboard
  layout: newspaper
  preferred_viewer: dashboards-next
  description: "September 2026 (202609)"
  elements:
  - name: hdr
    type: text
    title_text: ""
    body_text: '<div style="height:4px;background:linear-gradient(90deg,#5b3df5,#e5399e 45%,#1fc4e8)"></div><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:12px 8px"><div style="display:flex;align-items:center"><img src="data:image/png;base64," height="26" style="margin-right:14px"><span style="border-left:1px solid #e4e9f2;height:32px;margin-right:14px"></span><div><div style="font-size:19px;font-weight:650;color:#111a35">Billing Dashboard</div><div style="font-size:12.5px;color:#6b7794">Cycle: September 2026 (202609) &nbsp;|&nbsp; Invoice generation, accounts and acceptance metrics</div></div></div><div><a href="/dashboards/billing::revenue_dashboard" style="display:inline-block;padding:7px 16px;margin-left:6px;border-radius:99px;font-weight:600;font-size:13px;text-decoration:none;background:#fff;color:#5b3df5;border:1px solid #5b3df5">Revenue Dashboard</a><a href="/dashboards/billing::billing_dashboard" style="display:inline-block;padding:7px 16px;margin-left:6px;border-radius:99px;font-weight:600;font-size:13px;text-decoration:none;background:#5b3df5;color:#fff">Billing Dashboard</a></div></div>'
    row: 0
    col: 0
    width: 24
    height: 3
  - name: s1
    type: text
    title_text: ""
    body_text: '<div style="font-size:11px;letter-spacing:.9px;text-transform:uppercase;color:#6b7794;font-weight:700;border-bottom:1px solid #e4e9f2;padding-bottom:4px">Acceptance metrics &nbsp; AC 2.4-01 / 2.4-02</div>'
    row: 3
    col: 0
    width: 24
    height: 1
  - name: genrate
    title: "Invoice Generation Rate"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [bills_v3.generation_rate]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#0e9f57"
    enable_conditional_formatting: false
    text_color: "#0e9f57"
    value_format: '0.000%'
    note_state: expanded
    note_display: below
    note_text: "Generated invoices (eligible accounts) / eligible accounts"
    row: 4
    col: 0
    width: 6
    height: 4
  - name: acc
    type: text
    title_text: ""
    body_text: '<div style="background:#eaeef5;border-radius:12px;padding:16px;min-height:96px;color:#9aa6bd"><div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px">Invoice Accuracy Rate</div><div style="font-size:30px;font-weight:700;margin:6px 0">N/A</div><span style="background:#d5dbe8;color:#6b7794;font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:5px">N/A - MISSING COLUMN</span><div style="font-size:11.5px;margin-top:6px">MISSING: EXPECTED_AMOUNT. Needs the rule-harness baseline.</div></div>'
    row: 4
    col: 6
    width: 6
    height: 4
  - name: ungen
    title: "Ungenerated Accounts"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [account.ungenerated_accounts]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#d98200"
    enable_conditional_formatting: false
    text_color: "#d98200"
    value_format: '#,##0'
    note_state: expanded
    note_display: below
    note_text: "Eligible accounts with BILL_NO IS NULL"
    row: 4
    col: 12
    width: 6
    height: 4
  - name: dur
    type: text
    title_text: ""
    body_text: '<div style="background:#eaeef5;border-radius:12px;padding:16px;min-height:96px;color:#9aa6bd"><div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px">Bill Run Duration</div><div style="font-size:30px;font-weight:700;margin:6px 0">N/A</div><span style="background:#d5dbe8;color:#6b7794;font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:5px">N/A - MISSING COLUMN</span><div style="font-size:11.5px;margin-top:6px">MISSING: RUN_TIMESTAMPS. Needs run timestamps.</div></div>'
    row: 4
    col: 18
    width: 6
    height: 4
  - name: s2
    type: text
    title_text: ""
    body_text: '<div style="font-size:11px;letter-spacing:.9px;text-transform:uppercase;color:#6b7794;font-weight:700;border-bottom:1px solid #e4e9f2;padding-bottom:4px">Accounts by status</div>'
    row: 8
    col: 0
    width: 24
    height: 1
  - name: base
    title: "User Base"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [account.user_base]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#5b3df5"
    enable_conditional_formatting: false
    text_color: "#5b3df5"
    value_format: '#,##0'
    note_state: expanded
    note_display: below
    note_text: "All accounts in LEGACY.ACCOUNT"
    row: 9
    col: 0
    width: 6
    height: 4
  - name: active
    title: "Active Accounts"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [account.active_accounts]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#0e9f57"
    enable_conditional_formatting: false
    text_color: "#0e9f57"
    value_format: '#,##0'
    note_state: expanded
    note_display: below
    note_text: "ACCOUNT_STATUS = ACTIVE"
    row: 9
    col: 6
    width: 6
    height: 4
  - name: susp
    title: "Suspended / Pending"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [account.suspended_pending_accounts]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#d98200"
    enable_conditional_formatting: false
    text_color: "#d98200"
    value_format: '#,##0'
    note_state: expanded
    note_display: below
    note_text: "SUSPENDED + ACTIVE_PENDING (billing-eligible)"
    row: 9
    col: 12
    width: 6
    height: 4
  - name: term
    title: "Terminated (Total)"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [account.terminated_accounts]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#e5399e"
    enable_conditional_formatting: false
    text_color: "#e5399e"
    value_format: '#,##0'
    note_state: expanded
    note_display: below
    note_text: "ACCOUNT_STATUS = TERMINATED (not billed)"
    row: 9
    col: 18
    width: 6
    height: 4
  - name: s3
    type: text
    title_text: ""
    body_text: '<div style="font-size:11px;letter-spacing:.9px;text-transform:uppercase;color:#6b7794;font-weight:700;border-bottom:1px solid #e4e9f2;padding-bottom:4px">Acceptance, status mix and materiality</div>'
    row: 13
    col: 0
    width: 24
    height: 1
  - name: accept
    title: "Acceptance Metrics (AC 2.4-01 Generation)"
    model: billing
    explore: revenue_billing
    type: looker_grid
    fields: [bills_v3.generated_eligible, account.eligible_accounts, bills_v3.generation_rate, bills_v3.generation_result]
    show_view_names: false
    show_row_numbers: false
    transpose: false
    truncate_text: true
    hide_totals: false
    hide_row_totals: false
    size_to_fit: true
    table_theme: white
    header_text_alignment: left
    header_font_size: 12
    rows_font_size: 12
    show_sql_query_menu_options: false
    show_totals: false
    show_row_totals: false
    conditional_formatting:
    - type: equal to
      value: PASS
      background_color: "#d9f3e6"
      font_color: "#0e9f57"
      bold: true
      italic: false
      strikethrough: false
      fields: [bills_v3.generation_result]
    - type: equal to
      value: FAIL
      background_color: "#fde8d0"
      font_color: "#d98200"
      bold: true
      italic: false
      strikethrough: false
      fields: [bills_v3.generation_result]
    note_state: expanded
    note_display: below
    note_text: "PASS when generation rate is at least 99.95% (AC 2.4-01). Accuracy (AC 2.4-02): DISABLED"
    row: 14
    col: 0
    width: 10
    height: 6
  - name: status_donut
    title: "Accounts by Status"
    model: billing
    explore: revenue_billing
    type: looker_pie
    fields: [account.status_norm, account.user_base]
    sorts: [account.user_base desc]
    value_labels: legend
    label_type: labPer
    inner_radius: 55
    legend_position: right
    show_view_names: false
    color_application:
      collection_id: legacy
      palette_id: looker_classic
    row: 14
    col: 10
    width: 7
    height: 6
  - name: mat
    type: text
    title_text: ""
    body_text: '<div style="background:#eaeef5;border-radius:12px;padding:16px;min-height:96px;color:#9aa6bd"><div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px">Failure Materiality</div><div style="font-size:30px;font-weight:700;margin:6px 0">N/A</div><span style="background:#d5dbe8;color:#6b7794;font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:5px">N/A - MISSING COLUMN</span><div style="font-size:11.5px;margin-top:6px">MISSING: EXPECTED_AMOUNT. Sub-cent delta bands require baseline harness values.</div></div>'
    row: 14
    col: 17
    width: 7
    height: 6
  - name: ung_plan
    title: "Ungenerated Accounts by Rate Plan"
    model: billing
    explore: revenue_billing
    type: looker_bar
    fields: [account.currentplan_name, account.ungenerated_accounts]
    filters:
      account.ungenerated_accounts: ">0"
    sorts: [account.ungenerated_accounts desc]
    limit: 10
    x_axis_gridlines: false
    y_axis_gridlines: true
    show_view_names: false
    show_y_axis_labels: true
    show_x_axis_label: false
    show_y_axis_ticks: true
    show_value_labels: true
    label_density: 25
    legend_position: center
    ordering: none
    series_colors: {account.ungenerated_accounts: "#d98200"}
    x_axis_scale: auto
    y_axis_combined: true
    row: 20
    col: 0
    width: 9
    height: 7
  - name: ung_port
    title: "Ungenerated Accounts by Port Type"
    model: billing
    explore: revenue_billing
    type: looker_pie
    fields: [account.number_port_type, account.ungenerated_accounts]
    filters:
      account.ungenerated_accounts: ">0"
    sorts: [account.ungenerated_accounts desc]
    value_labels: legend
    label_type: labPer
    inner_radius: 55
    legend_position: right
    show_view_names: false
    color_application:
      collection_id: legacy
      palette_id: looker_classic
    row: 20
    col: 9
    width: 9
    height: 7
  - name: risk
    title: "Revenue at Risk"
    model: billing
    explore: revenue_billing
    type: single_value
    fields: [bills_v3.revenue_at_risk]
    show_single_value_title: true
    show_comparison: false
    custom_color_enabled: true
    custom_color: "#e5399e"
    enable_conditional_formatting: false
    text_color: "#e5399e"
    value_format: '$#,##0'
    note_state: expanded
    note_display: below
    note_text: "Ungenerated accounts x Average Invoice Value (estimated unbilled revenue)"
    row: 20
    col: 18
    width: 6
    height: 7
  - name: s4
    type: text
    title_text: ""
    body_text: '<div style="font-size:11px;letter-spacing:.9px;text-transform:uppercase;color:#6b7794;font-weight:700;border-bottom:1px solid #e4e9f2;padding-bottom:4px">Ungenerated accounts (BILL_NO IS NULL)</div>'
    row: 27
    col: 0
    width: 24
    height: 1
  - name: ung_table
    title: "Ungenerated Accounts"
    model: billing
    explore: revenue_billing
    type: looker_grid
    fields: [account.accountid, account.si_number, account.currentplan_name, account.account_status, account.number_port_type, account.porting_donor]
    filters:
      bills_v3.bill_no: "NULL"
      account.is_eligible: "Yes"
    limit: 500
    show_view_names: false
    show_row_numbers: false
    transpose: false
    truncate_text: true
    hide_totals: false
    hide_row_totals: false
    size_to_fit: true
    table_theme: white
    header_text_alignment: left
    header_font_size: 12
    rows_font_size: 12
    show_sql_query_menu_options: false
    show_totals: false
    show_row_totals: false
    row: 28
    col: 0
    width: 24
    height: 9
  - name: calc
    type: text
    title_text: ""
    body_text: '<div style="font-size:11px;letter-spacing:.9px;text-transform:uppercase;color:#6b7794;font-weight:700;border-bottom:1px solid #e4e9f2;padding-bottom:4px">How each field is calculated</div><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;padding:7px;color:#6b7794;font-size:11px;text-transform:uppercase;border-bottom:1px solid #e4e9f2">Field</th><th style="text-align:left;padding:7px;color:#6b7794;font-size:11px;text-transform:uppercase;border-bottom:1px solid #e4e9f2">Calculation</th><th style="text-align:left;padding:7px;color:#6b7794;font-size:11px;text-transform:uppercase;border-bottom:1px solid #e4e9f2">Source</th></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Invoice Generation Rate</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Unique BILL_NO (COUNT DISTINCT) for eligible accounts / eligible accounts</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">BILLS_V3, ACCOUNT</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Eligible accounts</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Status ACTIVE, SUSPENDED or ACTIVE_PENDING</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">ACCOUNT.ACCOUNT_STATUS</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Ungenerated Accounts</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Eligible accounts with no invoice for 202609 (LEFT JOIN, BILL_NO IS NULL)</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">ACCOUNT, BILLS_V3</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Active / Suspended-Pending / Terminated</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">COUNT(DISTINCT ACCOUNTID) by ACCOUNT_STATUS</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">ACCOUNT</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Revenue at Risk</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Ungenerated accounts x Average Invoice Value</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Derived</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Generation (AC 2.4-01)</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">PASS when generation rate is at least 99.95%</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Derived</td></tr><tr><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;font-weight:600">Accuracy, Duration, Materiality</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Disabled - need EXPECTED_AMOUNT / RUN_TIMESTAMPS</td><td style="padding:7px;border-bottom:1px solid #eef1f7;font-size:12.5px;">Not in schema</td></tr></table>'
    row: 38
    col: 0
    width: 24
    height: 7
